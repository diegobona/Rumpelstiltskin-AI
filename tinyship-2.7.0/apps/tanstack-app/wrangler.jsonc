{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rumpelstiltskin-ai",
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"observability": {
		"enabled": true,
		"traces": { "enabled": true }
	},
	"routes": [
		{ "pattern": "rumpelstiltskin-ai.co", "custom_domain": true },
		{ "pattern": "www.rumpelstiltskin-ai.co", "custom_domain": true }
	],
	// Non-sensitive environment variables
	"vars": {
		"DB_DIALECT": "d1",
		"APP_BASE_URL": "https://rumpelstiltskin-ai.co",
		"BETTER_AUTH_URL": "https://rumpelstiltskin-ai.co",
		"VITE_STORAGE_PROVIDER": "r2",
		"R2_PUBLIC_URL": "https://pub-7344a28ff09f475d9e99f883230bb927.r2.dev"
	},
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "rumpelstiltskin-ai-uploads",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tinyship-db",
			"database_id": "87ee7e74-c45a-447a-aa14-1a66130c306f",
			"migrations_dir": "../../libs/database/drizzle-sqlite"
		}
	],
	// Database acceleration via Hyperdrive (requires `npx wrangler hyperdrive create`)
	// Uncomment after creating a Hyperdrive config:
	// "hyperdrive": [
	//   {
	//     "binding": "HYPERDRIVE",
	//     "id": "<your-hyperdrive-config-id>"
	//   }
	// ]
	// Cloudflare D1 database (alternative to Hyperdrive+PostgreSQL)
	// Set DB_DIALECT=d1 in vars to activate D1 mode.
	// Create a D1 database first: npx wrangler d1 create tinyship-db
	// Then uncomment and fill in the database_id:
	// "d1_databases": [
	//   {
	//     "binding": "DB",
	//     "database_name": "tinyship-db",
	//     "database_id": "<your-d1-database-id>"
	//   }
	// ]
}
